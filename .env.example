# Zium Nova — Antigravity Protocol (Environment Variables)
# ⚠️ SECURITY: This file is safe to commit. NEVER commit .env or .env.*.local
# All secrets must be stored in Vercel Environment Variables dashboard.
# Rotate any key that has been exposed in git history or logs.

# ─── Server ───────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=https://your-frontend.vercel.app
NODE_ENV=production
# JWT_SECRET: Generate with `openssl rand -base64 32`. NEVER use a weak/known value.
JWT_SECRET=CHANGE_THIS_JWT_SECRET

# ─── PostgreSQL (Supabase) ────────────────────────────────────
# Get this from Supabase -> Project Settings -> Database -> Connection String (Transaction)
# The password in this URL MUST be rotated if it has ever been exposed.
DATABASE_URL=postgresql://postgres:[password]@[db-host]:5432/postgres?sslmode=require

# ─── AI Brain Providers (7+ Integrated Providers) ─────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SAMBANOVA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxx

# ─── Push Notifications (VAPID) ───────────────────────────────
# Generate these using `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=xxxx-xxxx-xxxx
VAPID_PRIVATE_KEY=xxxx-xxxx-xxxx
VAPID_SUBJECT=mailto:admin@ziumnova.app

# ─── Moltbook Integration ─────────────────────────────────────
MOLTBOOK_API_KEY=mb_v1_xxxxxxxxxxxx
MOLTBOOK_API_URL=https://api.moltbook.com/v1

# ─── Client (Frontend) ────────────────────────────────────────
# Add these to Vercel environment variables
VITE_API_BASE_URL=https://your-backend.railway.app/api
